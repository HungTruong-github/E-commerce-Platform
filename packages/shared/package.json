{
  "name": "@ecommerce/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared utility functions and cross-cutting constants for E-commerce Platform",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ecommerce/types": "workspace:*"
  },
  "devDependencies": {
    "@ecommerce/tsconfig": "workspace:*",
    "typescript": "^5.7.3"
  }
}

# ==============================================================================
# E-commerce Platform - Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# Application Environment
NODE_ENV=development

# API Service Configuration
API_PORT=4000
API_HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Web Frontend Configuration
VITE_PORT=3000
VITE_API_BASE_URL=http://localhost:4000/api/v1

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=ecommerce_user
DB_PASSWORD=ecommerce_dev_password
DB_NAME=ecommerce_db
DATABASE_URL=postgresql://ecommerce_user:ecommerce_dev_password@localhost:5432/ecommerce_db?schema=public

# Redis Configuration (BullMQ & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security
# WARNING: Change in production! Must be at least 32 characters long.
JWT_SECRET=development-only-insecure-jwt-secret-key-32-chars-minimum
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=development-only-insecure-refresh-jwt-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

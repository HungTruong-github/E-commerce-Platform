# ==============================================================================
# Production Dockerfile for NestJS API Service
# Multi-stage build with non-root runtime user
# ==============================================================================

# 1. Base stage
FROM node:22-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat dumb-init
RUN corepack enable && corepack prepare pnpm@9.15.5 --activate

# 2. Dependencies stage
FROM base AS dependencies
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/tsconfig/package.json ./packages/tsconfig/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/types/package.json ./packages/types/
COPY packages/shared/package.json ./packages/shared/
COPY apps/api/package.json ./apps/api/
RUN pnpm install --frozen-lockfile

# 3. Builder stage
FROM base AS builder
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/packages/tsconfig ./packages/tsconfig
COPY --from=dependencies /app/packages/types ./packages/types
COPY --from=dependencies /app/packages/shared ./packages/shared
COPY --from=dependencies /app/apps/api ./apps/api
COPY . .
# Generate Prisma Client & Build shared packages and API
RUN pnpm --filter @ecommerce/types build
RUN pnpm --filter @ecommerce/shared build
RUN pnpm --filter @ecommerce/api db:generate
RUN pnpm --filter @ecommerce/api build
# Prune development dependencies for minimal production footprint
RUN pnpm --filter @ecommerce/api --prod deploy pruned

# 4. Production Runner stage
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache dumb-init curl

# Security: create and switch to unprivileged user
USER node

# Copy built application and pruned production node_modules
COPY --chown=node:node --from=builder /app/pruned/node_modules ./node_modules
COPY --chown=node:node --from=builder /app/apps/api/dist ./dist
COPY --chown=node:node --from=builder /app/apps/api/prisma ./prisma
COPY --chown=node:node --from=builder /app/apps/api/package.json ./package.json

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:4000/api/v1/health || exit 1

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "dist/main"]


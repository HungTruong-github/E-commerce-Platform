{
  "name": "ecommerce-platform-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NovaStore – PC & Gaming Setup Customization Commerce Platform Monorepo",
  "repository": {
    "type": "git",
    "url": "https://github.com/HungTruong-github/E-commerce-Platform.git"
  },
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ecommerce/web --filter @ecommerce/api dev",
    "dev:web": "pnpm --filter @ecommerce/web dev",
    "dev:api": "pnpm --filter @ecommerce/api dev",
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:unit": "pnpm --filter @ecommerce/web test -- --run && pnpm --filter @ecommerce/api test",
    "test:e2e": "playwright test",
    "db:validate": "pnpm --filter @ecommerce/api db:validate",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "pnpm -r run clean",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
